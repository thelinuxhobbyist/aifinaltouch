{
  "name": "aifinaltouch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-env=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:dev": "set -a && . ./.env.development.local && set +a && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:prod": "opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.8",
    "@opennextjs/cloudflare": "^1.20.7",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "typescript": "^5",
    "wrangler": "^4.144.0"
  },
  "packageManager": "pnpm@9.15.9"
}
