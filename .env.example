# Copy to .env.development.local for `pnpm dev` and to .env.production.local
# (production Clerk publishable key only) before `pnpm deploy:prod`.
# Never use .env.local: Next.js loads it for production builds too.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values for `next dev`. In deployed Workers these are Wrangler secrets.
CLERK_SECRET_KEY=sk_test_xxx
RESEND_API_KEY=
EMAIL_FROM="AI Final Touch <notifications@dev.aifinaltouch.com>"
ADMIN_EMAILS=you@example.com
